# Porta do servidor HTTP (padrão 3000)
PORT="3000"

# Senha de acesso ao piloto hospedado (usuário: piloto).
# Gere um valor aleatório de 64 caracteres hexadecimais e mantenha-o fora do Git.
PILOT_ACCESS_PASSWORD=""

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Segredo criptográfico para assinatura de sessões (gerar com 32+ bytes aleatórios em produção)
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_HEX_IN_PRODUCTION"

# Chave AES-256-GCM em hex (64 caracteres) para cifragem adicional do compartimento segregado
# (dados bancários e atributos sensíveis de pré-ingresso)
VAULT_ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_KEY_IN_PRODUCTION"

# Caminho do banco SQLite de demonstração em ambiente de desenvolvimento
DEV_DB_PATH="data/enap-evida.db"

# Referência arquitetural para PostgreSQL em ambiente institucional homologado (não utilizado no modo demonstrativo local)
PGHOST=""
PGPORT="5432"
PGDATABASE="enap_evida"
PGUSER=""
PGPASSWORD=""

# Integrações institucionais futuras (aguardando autorização formal da área de TI/Segurança)
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT=""
